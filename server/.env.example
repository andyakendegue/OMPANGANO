# Copier en .env (jamais commité). Les valeurs marquées « à fournir » viennent du propriétaire (voir README, section Paramètres).
POSTGRES_PASSWORD=changer-moi
GARAGE_RPC_SECRET=          # openssl rand -hex 32
S3_BUCKET=ompangano
S3_ACCESS_KEY_ID=           # donnée par scripts/init-garage.sh
S3_SECRET_ACCESS_KEY=       # idem

# CORS : domaines du site autorisés à appeler l'API
CORS_ORIGINS=https://ompangano.web.app,https://ompangano.firebaseapp.com,https://source.essaka.engineering,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- Production (à fournir par le propriétaire) ---
S3_PUBLIC_ENDPOINT=https://media-ompangano.essaka.engineering
# BACKUP_REMOTE=user@hote:/chemin          # destination des sauvegardes hors VPS : à fournir
BIND_IP=127.0.0.1                      # sur le VPS : 172.17.0.1

# --- Nkala -------------------------------------------------------------------
# Obligatoire : signe les sessions ouvertes par SMS (openssl rand -hex 32)
SESSION_SECRET=
# Modules ouverts (liste séparée par des virgules) ; les interrupteurs de la console d'administration ont le dernier mot
MODULES_ACTIFS=ompangano,onenji,azeva,ontci,nkala
FONCTIONS_ACTIVES=
# À connecter à la fin (voir ../SERVICES_A_CONNECTER.md) : laisser vide tant que le service n'est pas créé
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
ANTHROPIC_API_KEY=
IA_MODELE=claude-haiku-5-5
REVIVE_URL=
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=

# --- Modes : tout fonctionne en simulation tant que la variable du service est vide ---------------------------------
# Connexion par SMS : twilio (TWILIO_*) ou simulation (code 000000, jamais en production)
SMS_FOURNISSEUR=
# Administrateurs désignés par numéro (liste séparée par des virgules)
ADMIN_TELEPHONES=
# Assistant : anthropic | runpod | openai | simulation (vide = détecté d'après les clés présentes)
IA_FOURNISSEUR=
# RunPod : clé de gestion (pods, serverless, volumes réseau) et points d'accès de l'assistant et des embeddings
RUNPOD_API_KEY=
RUNPOD_LLM_ENDPOINT=
RUNPOD_LLM_URL=
RUNPOD_EMBED_ENDPOINT=
RUNPOD_EMBED_URL=
EMBEDDING_FOURNISSEUR=
EMBEDDING_MODELE=BAAI/bge-m3
# Autre fournisseur compatible OpenAI (vLLM, TGI…)
IA_BASE_URL=
IA_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Régie Revive (voir regie/README.md) : vide = régie interne seule
REVIVE_USER=
REVIVE_PASSWORD=
# Notifications : expo | simulation
PUSH_FOURNISSEUR=
EXPO_ACCESS_TOKEN=
# Achats : simulation (reçus « simule:… », jamais en production) ou magasins (APPLE_*, GOOGLE_*)
ACHATS_FOURNISSEUR=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=nkala.essaka.engineering
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_PACKAGE_NAME=nkala.essaka.engineering
# Adresse publique de l'API (listes HLS, clés) si le proxy ne la transmet pas
PUBLIC_API_URL=

# --- Paiements Mobile Money (manuel | api | simulation) ----------------------------------------------------------
MOBILEMONEY_FOURNISSEUR=manuel
MOBILEMONEY_NUMERO_AIRTEL=
MOBILEMONEY_NUMERO_MOOV=
MOBILEMONEY_API_URL=
MOBILEMONEY_API_KEY=
MOBILEMONEY_WEBHOOK_SECRET=
# --- Base vectorielle du RAG (vide = PostgreSQL) ------------------------------------------------------------------
VECTOR_URL=
VECTOR_API_KEY=
VECTOR_COLLECTION=nkala_rag

# Dossier de référence du RAG : tout ce qui est déposé dans /opt/embeddings est vectorisé chaque nuit (cron) et à la demande (console)
EMBEDDINGS_HOTE=/opt/embeddings

# Livres libres de droits déposés dans /opt/bibliotheque : lus, découpés en chapitres et publiés dans Onenji (BIBLIOTHEQUE_RAG=non pour ne pas les donner au RAG)
BIBLIOTHEQUE_HOTE=/opt/bibliotheque
