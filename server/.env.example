# Copier en .env (jamais commité). Les valeurs marquées « à fournir » viennent du propriétaire (voir README, section Paramètres).
POSTGRES_PASSWORD=changer-moi
GARAGE_RPC_SECRET=          # openssl rand -hex 32
S3_BUCKET=ompangano
S3_ACCESS_KEY_ID=           # donnée par scripts/init-garage.sh
S3_SECRET_ACCESS_KEY=       # idem

# CORS : domaines du site autorisés à appeler l'API
CORS_ORIGINS=https://ompangano.web.app,http://localhost:3000,http://localhost:5173

# --- Production (à fournir par le propriétaire) ---
API_DOMAIN=api.essaka.engineering          # proposition, à confirmer
MEDIA_DOMAIN=media.essaka.engineering      # proposition, à confirmer
S3_PUBLIC_ENDPOINT=https://media.essaka.engineering
# BACKUP_REMOTE=user@hote:/chemin          # destination des sauvegardes hors VPS : à fournir
