# Copier en .env (jamais commité). Les valeurs marquées « à fournir » viennent du propriétaire (voir README, section Paramètres).
POSTGRES_PASSWORD=changer-moi
GARAGE_RPC_SECRET=          # openssl rand -hex 32
S3_BUCKET=ompangano
S3_ACCESS_KEY_ID=           # donnée par scripts/init-garage.sh
S3_SECRET_ACCESS_KEY=       # idem

# CORS : domaines du site autorisés à appeler l'API
CORS_ORIGINS=https://ompangano.web.app,https://ompangano.firebaseapp.com,https://source.essaka.engineering,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- Production (à fournir par le propriétaire) ---
S3_PUBLIC_ENDPOINT=https://media-ompangano.essaka.engineering
# BACKUP_REMOTE=user@hote:/chemin          # destination des sauvegardes hors VPS : à fournir
BIND_IP=127.0.0.1                      # sur le VPS : 172.17.0.1

# --- Nkala -------------------------------------------------------------------
# Obligatoire : signe les sessions ouvertes par SMS (openssl rand -hex 32)
SESSION_SECRET=
# Modules ouverts (liste séparée par des virgules) ; les interrupteurs de la console d'administration ont le dernier mot
MODULES_ACTIFS=ompangano,onenji,azeva,ontci,nkala
FONCTIONS_ACTIVES=
# À connecter à la fin (voir ../SERVICES_A_CONNECTER.md) : laisser vide tant que le service n'est pas créé
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
ANTHROPIC_API_KEY=
IA_MODELE=claude-haiku-5-5
REVIVE_URL=
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=
