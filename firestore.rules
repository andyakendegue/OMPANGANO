rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Profils utilisateurs OMPAGANO
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Registre dynamique des Clans Myènè
    match /clans/{clanId} {
      allow read: if true;
      allow write: if true;
    }

    // Registre dynamique des Villages Myènè
    match /villages/{villageId} {
      allow read: if true;
      allow write: if true;
    }

    // Questionnaires, mots et phrases
    match /items/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // Contributions vocales et orthographiques
    match /contributions/{contributionId} {
      allow read: if true;
      allow write: if true;
    }

    // Métriques et statistiques système synchronisées
    match /metrics/{metricId} {
      allow read: if true;
      allow write: if true;
    }

    // Défis Hebdomadaires
    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if true;
    }

    // Thèmes dynamiques OMPAGANO
    match /themes/{themeId} {
      allow read: if true;
      allow write: if true;
    }

    // Badges aux dénominations dynamiques
    match /badges/{badgeId} {
      allow read: if true;
      allow write: if true;
    }

    // Liste des administrateurs
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
