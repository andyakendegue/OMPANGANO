rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'andymigoumbi@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidator() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['validator', 'admin'])
      );
    }

    // Profils utilisateurs OMPAGANO
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        request.auth.uid == userId || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Registre dynamique des Clans Myènè
    match /clans/{clanId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Registre dynamique des Villages Myènè
    match /villages/{villageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Questionnaires, mots et phrases
    match /items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Contributions vocales et orthographiques
    match /contributions/{contributionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isValidator()
      );
      allow delete: if isAdmin();
    }

    // Métriques et statistiques système synchronisées
    match /metrics/{metricId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Défis Hebdomadaires
    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Thèmes dynamiques OMPAGANO
    match /themes/{themeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Badges aux dénominations dynamiques
    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Liste des administrateurs
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
