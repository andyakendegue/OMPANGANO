rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Vérifie si l'utilisateur est authentifié avec une session Firebase valide
    function isSignedIn() {
      return request.auth != null;
    }

    // Vérifie si l'utilisateur est le propriétaire du document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Vérifie si l'utilisateur a le rôle administrateur (inclut andymigoumbi@gmail.com)
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'andymigoumbi@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Profils utilisateurs OMPAGANO : lecture et écriture STRICTEMENT réservées aux connectés
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // Registre dynamique des Clans Myènè : lecture et écriture réservées aux connectés
    match /clans/{clanId} {
      allow read, write: if isSignedIn();
    }

    // Registre dynamique des Villages Myènè : lecture et écriture réservées aux connectés
    match /villages/{villageId} {
      allow read, write: if isSignedIn();
    }

    // Questionnaires, mots et phrases : lecture et écriture réservées aux connectés
    match /items/{itemId} {
      allow read, write: if isSignedIn();
    }

    // Contributions vocales et orthographiques : lecture et écriture réservées aux connectés
    match /contributions/{contributionId} {
      allow read, write: if isSignedIn();
    }

    // Métriques et statistiques système synchronisées
    match /metrics/{metricId} {
      allow read, write: if isSignedIn();
    }

    // Défis Hebdomadaires
    match /challenges/{challengeId} {
      allow read, write: if isSignedIn();
    }

    // Thèmes dynamiques OMPAGANO
    match /themes/{themeId} {
      allow read, write: if isSignedIn();
    }

    // Badges aux dénominations dynamiques
    match /badges/{badgeId} {
      allow read, write: if isSignedIn();
    }

    // Liste des administrateurs
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Diagnostics / Test de connexion
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
