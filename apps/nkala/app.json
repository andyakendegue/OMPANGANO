{
  "expo": {
    "name": "Nkala",
    "slug": "nkala",
    "scheme": "nkala",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "engineering.essaka.nkala",
      "supportsTablet": true
    },
    "android": {
      "package": "engineering.essaka.nkala"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png",
      "name": "Nkala",
      "backgroundColor": "#170d08",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Nkala utilise le micro pour enregistrer votre voix lorsque vous contribuez."
        }
      ],
      "expo-asset",
      "expo-web-browser",
      "expo-video",
      "expo-localization",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
